# ============================================================
# .env.azure.example — Copiar a .env en la VM de Azure
# NUNCA subir este archivo con valores reales al repositorio
# ============================================================

APP_NAME="Secretaria FII-UNP"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:GENERA_CON_php_artisan_key_generate
APP_URL=https://tudominio.com

# Base de datos
DB_DATABASE=gestion_academica
DB_USERNAME=secretaria
DB_PASSWORD=CAMBIA_ESTA_CONTRASEÑA
DB_ROOT_PASSWORD=CAMBIA_ESTA_CONTRASEÑA_ROOT

# Redis / Cache / Sesiones
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=database

# Sanctum (mismo dominio que APP_URL sin https://)
SANCTUM_STATEFUL_DOMAINS=tudominio.com

# Correo Gmail
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tucorreo@gmail.com
MAIL_PASSWORD=tu_app_password_de_gmail
MAIL_FROM_ADDRESS=noreply@tudominio.com
MAIL_FROM_NAME="Secretaria FII-UNP"

# LLM (Groq)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXX
GROQ_MODEL=llama-3.3-70b-versatile

# WhatsApp (opcional)
WHATSAPP_WEBHOOK_SECRET=
